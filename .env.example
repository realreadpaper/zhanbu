# ==================== 数据库配置 ====================
# PostgreSQL 连接信息
DB_USER=zhanbu
DB_PASSWORD=zhanbu_secret
DB_NAME=zhanbu

# 应用连接数据库的配置（通常不需要修改，docker-compose 会自动设置）
# ZHANBU_DB_HOST=db
# ZHANBU_DB_PORT=15432
# ZHANBU_DB_USER=zhanbu
# ZHANBU_DB_PASSWORD=zhanbu_secret
# ZHANBU_DB_NAME=zhanbu
# ZHANBU_DB_SSLMODE=disable

# ==================== 应用配置 ====================
# JWT 密钥（⚠️ 生产环境必须修改！）
JWT_SECRET=change-this-to-a-secure-secret

# 服务器模式：debug | release
# ZHANBU_SERVER_MODE=release
# Render 会自动注入 PORT；本地 Docker Compose 已设置 ZHANBU_SERVER_PORT=8080
# ZHANBU_SERVER_PORT=18080

# Render 免费/低配实例上注册 bcrypt 哈希可能较慢，可临时设为 8；默认使用 bcrypt 标准成本 10
# ZHANBU_BCRYPT_COST=10

# 前后端分离部署时的跨域白名单（Render 后端使用）
# 例：ZHANBU_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.fun
ZHANBU_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Vercel 前端使用，必须以 VITE_ 开头；本地开发不填时默认使用 /api 走 Vite/Nginx 代理
# 例：VITE_API_BASE_URL=https://your-api.onrender.com/api
# VITE_API_BASE_URL=

# ==================== AI 配置 ====================
# OpenAI 兼容 API 配置（例如 xiaomo）
AI_API_KEY=
AI_MODEL=mimo-v2.5-pro
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 可选：覆盖生成长度和温度
# AI_MAX_TOKENS=3000
# ZHANBU_AI_TEMPERATURE=0.7

# ==================== SMTP 邮件配置 ====================
# ZHANBU_SMTP_ENABLED=false
# ZHANBU_SMTP_HOST=smtp.qq.com
# ZHANBU_SMTP_PORT=465
# ZHANBU_SMTP_USERNAME=your-email@qq.com
# ZHANBU_SMTP_PASSWORD=your-smtp-auth-code
# ZHANBU_SMTP_FROM=占卜网 <your-email@qq.com>
